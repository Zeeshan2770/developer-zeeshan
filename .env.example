# Copy to .env.local for development. Set the same values in Netlify > Site settings > Environment variables.
# Only the public anon key belongs here. NEVER put the service-role key in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_SITE_URL=https://your-domain.example
